<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 与主 App（Runner.entitlements）声明同一个 App Group，
	     widget 侧 UserDefaults(suiteName: "group.com.cyshine.music") 才有权限读。 -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.cyshine.music</string>
	</array>
	<!-- 前缀用 $(AppIdentifierPrefix) 自动取，与主 App 的 bundle id 成父子关系。
	     这样侧签工具重签时主 App 与扩展的 application-identifier 前缀一致，
	     iOS 才会加载 appex（伪签前缀对不上正是扩展加载失败的根因）。 -->
	<key>application-identifier</key>
	<string>$(AppIdentifierPrefix)$(PRODUCT_BUNDLE_IDENTIFIER)</string>
</dict>
</plist>
